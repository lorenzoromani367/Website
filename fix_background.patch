+  // Blocca l'autoplay quando il tab del browser non è visibile, 
+  // per evitare che continui ad avanzare in background.
+  document.addEventListener("visibilitychange", () => {
+    if (document.hidden) {
+      clearTimeout(autoplayTimer);
+    } else {
